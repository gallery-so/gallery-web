{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gallery-web",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 10000
  }
}
